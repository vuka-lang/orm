// Command blog is the ORM at work in Vuka: models declared with field
// attributes (their Schema methods), migrations written by orm
// makemigrations, queries through the models' typed fields.
package main

import (
	"context"
	"errors"
	"fmt"
	"log"
	"os"
	"strings"
	"time"

	"github.com/vuka-lang/orm/v2"
	"github.com/vuka-lang/orm/v2/sqlite"

	_ "example.com/blog/migrations"
)

// A typed custom function, computed in Go on SQLite.
var words = orm.OrderedFunc[int]("words", orm.Arity(1))

func init() {
	if err := sqlite.Func("words", func(s string) int { return len(strings.Fields(s)) }); err != nil {
		panic(err)
	}
}

func main() {
	if err := run(context.Background()); err != nil {
		log.Fatal(err)
	}
}

func run(ctx context.Context) error {
	os.Remove("blog.db") // a fresh database each run
	db := orm.ConnectURL("sqlite:blog.db")?
	orm.AddDatabase("main", db, orm.AsDefault())
	orm.Migrate(ctx)?
	seed(ctx)?

	posts := Post.Objects.Filter(Post.Title.Contains("Go"), Post.Author.Name.Eq("ada")).OrderBy(Post.Views.Desc()).All(ctx)?
	fmt.Println("ada's Go posts:", titles(posts))

	for _, slug := range []string{"generics", "nope"} {
		p, err := Post.Objects.Get(ctx, Post.Slug.Eq(slug))
		switch {
		case errors.Is(err, orm.ErrNotFound):
			fmt.Printf("get %q: no such post\n", slug)
		case err != nil:
			return err
		default:
			fmt.Printf("get %q: %s (%d views)\n", slug, p.Title, p.Views)
		}
	}

	switch first, err := Post.Live().First(ctx); {
	case errors.Is(err, orm.ErrNotFound):
		fmt.Println("nothing published")
	case err != nil:
		return err
	default:
		fmt.Println("latest published:", first.Title)
	}

	p := Post.Objects.SelectRelated("author").PrefetchRelated(Post.Tags).Get(ctx, Post.Slug.Eq("tooling"))?
	fmt.Printf("%q by %s, tagged %s\n", p.Title, p.Author.Related().Name, tagNames(p.Tags.Rows()))

	publish(ctx, "tooling")?
	if err := publish(ctx, "nope"); err != nil {
		fmt.Println("publish nope:", err, "(rolled back)")
	}
	live := Post.Live().Count(ctx)?
	fmt.Println("published now:", live)

	type Stats struct {
		Author string `orm:"author__name"`
		Posts  int64
		Total  int
	}
	stats := Post.Objects.Annotate("posts", orm.Count("id")).Annotate("total", orm.Sum("views")).
		OrderBy(Post.Author.Name.Asc()).Values[Stats]("author__name", "posts", "total").All(ctx)?
	for _, s := range stats {
		fmt.Printf("%s: %d posts, %d views\n", s.Author, s.Posts, s.Total)
	}

	heat := orm.Case(orm.When(Post.Views.Gte(100), "hot"), orm.When(Post.Views.Gte(20), "warm")).Else("cold")
	type Heat struct {
		Title string
		Heat  string
		Words int
	}
	heats := Post.Objects.Annotate("heat", heat).Annotate("words", words(Post.Body.Expr())).
		OrderBy(Post.ID.Asc()).Values[Heat]("title", "heat", "words").All(ctx)?
	for _, h := range heats {
		fmt.Printf("%-16s %-4s %d words\n", h.Title, h.Heat, h.Words)
	}

	long := Post.Objects.Filter(words(Post.Body.Expr()).Ge(5)).Order(words(Post.Body.Expr()).Desc()).All(ctx)?
	fmt.Println("long reads:", titles(long))

	search(ctx)?

	Post.Objects.Filter(Post.Tags.Name.Eq("go")).Update(ctx, orm.Set{"views": orm.SQL("{0} + 1", Post.Views.Expr())})?
	tagged := Post.Objects.Filter(Post.Tags.Name.Eq("go")).OrderBy(Post.ID.Asc()).All(ctx)?
	fmt.Println("tagged go, views now:", views(tagged))
	return nil
}

// search is text, trigram and vector search, with typed fields.
func search(ctx context.Context) error {
	doc, q := orm.SearchVector(Post.Title.Name(), Post.Body.Name()), orm.SearchQuery("go command")
	found := Post.Objects.Filter(orm.Match(doc, q)).Order(orm.SearchRank(doc, q).Desc()).All(ctx)?
	fmt.Println("search \"go command\":", titles(found))
	like := Post.Objects.Annotate("sim", orm.Similarity(Post.Title.Name(), "go tools")).OrderBy("-sim").Limit(1).All(ctx)?
	fmt.Println("most like \"go tools\":", titles(like))
	near := Post.Objects.Nearest(Post.Embedding.Name(), orm.Vector{1, 0, 0}).Limit(2).All(ctx)?
	fmt.Println("nearest to [1 0 0]:", titles(near))
	close := Post.Objects.Filter(orm.CosineDistance(Post.Embedding.Name(), orm.Vector{0, 0, 1}).Lt(0.2)).All(ctx)?
	fmt.Println("within 0.2 of [0 0 1]:", titles(close))
	return nil
}

// publish sets the post published, in a transaction.
@orm.Transaction
func publish(ctx context.Context, slug string) error {
	p := Post.Objects.Get(ctx, Post.Slug.Eq(slug))?
	p.Published = Some(time.Now())
	return p.Save(ctx)
}

func seed(ctx context.Context) error {
	ada, bob := User{Name: "ada", Email: "ada@example.com"}, User{Name: "bob", Email: "bob@example.com"}
	ada.Save(ctx)?
	bob.Save(ctx)?
	golang, _, err := Tag.Objects.GetOrCreate(ctx, orm.Q{"name": "go"}, nil)
	if err != nil {
		return err
	}
	tools, _, err := Tag.Objects.GetOrCreate(ctx, orm.Q{"name": "tools"}, nil)
	if err != nil {
		return err
	}
	day := time.Date(2026, 9, 1, 0, 0, 0, 0, time.UTC)
	posts := []*Post{
		{Title: "Go generics", Slug: "generics", Body: "Type parameters arrive in Go, at last.", Author: orm.FKOf(&ada), Published: Some(day), Views: 120, Embedding: orm.Vector{0.9, 0.1, 0}},
		{Title: "Go tooling", Slug: "tooling", Body: "The go command does a lot.", Author: orm.FKOf(&ada), Views: 40, Embedding: orm.Vector{0.7, 0.3, 0}},
		{Title: "SQL by hand", Slug: "sql", Body: "Joins.", Author: orm.FKOf(&bob), Views: 5, Embedding: orm.Vector{0, 0.2, 0.9}},
	}
	for _, p := range posts {
		p.Save(ctx)?
	}
	posts[0].Tags.Add(ctx, &golang)?
	posts[1].Tags.Add(ctx, &golang, &tools)?
	return nil
}

func titles(ps []Post) []string {
	var out []string
	for _, p := range ps {
		out = append(out, p.Title)
	}
	return out
}

func tagNames(ts []Tag) []string {
	var out []string
	for _, t := range ts {
		out = append(out, t.Name)
	}
	return out
}

func views(ps []Post) []int {
	var out []int
	for _, p := range ps {
		out = append(out, p.Views)
	}
	return out
}
