package main

import (
	"context"
	"io"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

func TestApp(t *testing.T) {
	app, err := newApp(t.TempDir())
	if err != nil {
		t.Fatal(err)
	}
	if err := app.Start(context.Background()); err != nil {
		t.Fatal(err)
	}
	defer app.Stop(context.Background())
	srv := httptest.NewServer(app.Handler())
	defer srv.Close()
	do := func(method, path string, header ...string) string {
		req, _ := http.NewRequest(method, srv.URL+path, nil)
		if len(header) == 2 {
			req.Header.Set(header[0], header[1])
		}
		res, err := http.DefaultClient.Do(req)
		if err != nil {
			t.Fatal(err)
		}
		defer res.Body.Close()
		b, _ := io.ReadAll(res.Body)
		if res.StatusCode != 200 {
			t.Fatalf("%s %s: %d %s", method, path, res.StatusCode, b)
		}
		return string(b)
	}
	if got := do("GET", "/products"); !strings.Contains(got, "main lamp") {
		t.Fatal(got)
	}
	if got := do("POST", "/products?name=desk&price=300"); !strings.Contains(got, "desk") {
		t.Fatalf("read your write: %s", got)
	}
	do("POST", "/sell?product=1&amount=2")
	do("POST", "/sell?product=1&amount=3")
	if got := do("GET", "/report"); !strings.Contains(got, `"Product":"main lamp","Sold":5,"Sales":2`) {
		t.Fatal(got)
	}
	if got := do("GET", "/products", "X-Tenant", "acme"); !strings.Contains(got, "acme lamp") || strings.Contains(got, "main lamp") {
		t.Fatal(got)
	}
	if got := do("GET", "/healthz"); !strings.Contains(got, `"status":"ok"`) {
		t.Fatal(got)
	}
}
