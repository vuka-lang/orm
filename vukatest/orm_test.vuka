package vukatest

import (
	"context"
	"errors"
	"strconv"
	"testing"
	"time"

	"github.com/vuka-lang/orm"
	"github.com/vuka-lang/orm/ormtest"
	"github.com/vuka-lang/vuka"
)

func must[T any](t *testing.T, r Result[T]) T {
	t.Helper()
	v, err := r.Get()
	if err != nil {
		t.Fatal(err)
	}
	return v
}

// all is the rows qs reads.
func all(t *testing.T, ctx context.Context, qs orm.QuerySet[Post]) []Post {
	t.Helper()
	return must(t, vuka.Of(qs.All(ctx)))
}

func count[T any](t *testing.T, ctx context.Context, qs orm.QuerySet[T]) int64 {
	t.Helper()
	return must(t, vuka.Of(qs.Count(ctx)))
}

func check(t *testing.T, err error) {
	t.Helper()
	if err != nil {
		t.Fatal(err)
	}
}

func eq[V comparable](t *testing.T, what string, got, want V) {
	t.Helper()
	if got != want {
		t.Fatalf("%s = %v, want %v", what, got, want)
	}
}

type fixture struct {
	ada, bob   User
	golang, db Tag
	p1, p2, p3 Post
}

// seed: three posts — two by ada (one published), one by bob.
func seed(t *testing.T) (context.Context, *fixture) {
	ctx := ormtest.Open(t, managers()...)
	f := &fixture{ada: User{Name: "ada", Email: "ada@x", Age: 36}, bob: User{Name: "bob", Email: "bob@x", Age: 20}}
	check(t, f.ada.Save(ctx))
	check(t, f.bob.Save(ctx))
	f.golang, f.db = Tag{Name: "go"}, Tag{Name: "db"}
	check(t, f.golang.Save(ctx))
	check(t, f.db.Save(ctx))
	day := time.Date(2025, 3, 1, 0, 0, 0, 0, time.UTC)
	f.p1 = Post{Title: "Go generics", Body: "type parameters in go", Author: orm.FKOf(&f.ada), Published: Some(day), Views: 100, Likes: 7,
		Meta: orm.JSONOf(PostMeta{Lang: "en"}), Labels: orm.CSVOf("a", "b"), Embedding: orm.Vector{1, 0}}
	f.p2 = Post{Title: "SQL joins", Body: "joins in databases", Author: orm.FKOf(&f.ada), Views: 10, Likes: 20, Embedding: orm.Vector{0, 1}}
	f.p3 = Post{Title: "go tooling", Body: "the go command", Author: orm.FKOf(&f.bob), Editor: orm.FKOf(&f.ada), Views: 50, Likes: 1, Embedding: orm.Vector{1, 1}}
	for _, p := range []*Post{&f.p1, &f.p2, &f.p3} {
		check(t, p.Save(ctx))
	}
	check(t, f.p1.Tags.Add(ctx, &f.golang))
	check(t, f.p2.Tags.Add(ctx, &f.db))
	check(t, f.p3.Tags.Add(ctx, &f.golang, &f.db))
	return ctx, f
}

func eqTitles(t *testing.T, got []Post, want ...string) {
	t.Helper()
	var g []string
	for _, p := range got {
		g = append(g, p.Title)
	}
	if len(g) != len(want) {
		t.Fatalf("titles = %q, want %q", g, want)
	}
	for i := range g {
		if g[i] != want[i] {
			t.Fatalf("titles = %q, want %q", g, want)
		}
	}
}

func TestFilterAndOrder(t *testing.T) {
	ctx, _ := seed(t)
	ps := Post.Objects.QuerySet
	// Meta's ordering, from the attribute on orm.Base: -views.
	eqTitles(t, all(t, ctx, ps), "Go generics", "go tooling", "SQL joins")
	eqTitles(t, all(t, ctx, ps.Filter(Post.Title.Contains("Go"), Post.Author.Name.Eq("ada"))), "Go generics")
	eqTitles(t, all(t, ctx, ps.Exclude(Post.Author.Name.Eq("ada"))), "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Or(Post.Views.Lt(20), Post.Author.Age.Lte(20))).OrderBy(Post.Views.Asc())), "SQL joins", "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Not(Post.Views.In(10, 50)))), "Go generics")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Q{"title__icontains": "GO"}).OrderBy(Post.Views.Asc())), "go tooling", "Go generics")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Q{"views__gte": 50}).OrderBy(Post.ID.Asc()).Limit(1).Offset(1)), "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(Post.Tags.Name.Eq("go")).Distinct().OrderBy(Post.ID.Asc())), "Go generics", "go tooling")
	eqTitles(t, all(t, ctx, Post.Live()), "Go generics")
	eqTitles(t, all(t, ctx, ps.Filter(Post.Published.IsNull(true), Post.Editor.ID.IsNull(false))), "go tooling")
	eqTitles(t, all(t, ctx, ps.Order(orm.Length(Post.Title.Expr()).Desc(), orm.Asc(Post.ID.Expr()))), "Go generics", "go tooling", "SQL joins")
	eqTitles(t, all(t, ctx, ps.OrderBy("likes")), "go tooling", "Go generics", "SQL joins")
}

func TestGetFirst(t *testing.T) {
	ctx, f := seed(t)
	describe := func(p Post, err error) string {
		switch {
		case errors.Is(err, orm.ErrNotFound):
			return "none"
		case errors.Is(err, orm.ErrMultipleFound):
			return "several"
		case err != nil:
			return err.Error()
		}
		return p.Title
	}
	eq(t, "get", describe(Post.Objects.Get(ctx, Post.ID.Eq(f.p2.ID))), "SQL joins")
	eq(t, "get none", describe(Post.Objects.Get(ctx, Post.Title.Eq("nope"))), "none")
	eq(t, "get several", describe(Post.Objects.Get(ctx, Post.Author.Name.Eq("ada"))), "several")
	eq(t, "first", describe(Post.Live().First(ctx)), "Go generics")
	eq(t, "first none", describe(Post.Objects.Filter(Post.Views.Gt(1000)).First(ctx)), "none")
	eq(t, "count", count(t, ctx, Post.Objects.Filter(Post.Author.Name.Eq("ada"))), int64(2))
	eq(t, "exists", must(t, vuka.Of(Post.Objects.Filter(Post.Tags.Name.Eq("db")).Exists(ctx))), true)
}

func TestRelations(t *testing.T) {
	ctx, f := seed(t)
	ps := all(t, ctx, Post.Objects.SelectRelated(Post.Author.String()).PrefetchRelated(Post.Tags).OrderBy(Post.ID.Asc()))
	eq(t, "author loaded", ps[0].Author.Loaded(), true)
	eq(t, "author", ps[2].Author.Related().Name, "bob")
	eq(t, "tags loaded", len(ps[2].Tags.Rows()), 2)
	p := must(t, vuka.Of(Post.Objects.Get(ctx, Post.ID.Eq(f.p3.ID))))
	eq(t, "lazy", p.Author.Loaded(), false)
	eq(t, "fk get", must(t, p.Author.Get(ctx)).Name, "bob")
	eq(t, "fk id", p.Editor.ID(), f.ada.ID)
	eq(t, "m2m all", len(must(t, p.Tags.All(ctx))), 2)
	check(t, p.Tags.Remove(ctx, &f.db))
	eq(t, "removed", len(must(t, p.Tags.All(ctx))), 1)
	check(t, p.Tags.Set(ctx, f.db.ID))
	eq(t, "set", must(t, p.Tags.All(ctx))[0].Name, "db")
	check(t, p.Tags.Clear(ctx))
	eq(t, "clear", len(must(t, p.Tags.All(ctx))), 0)
	check(t, p.Add(ctx, Post.Tags, &f.golang))
	eq(t, "base add", len(must(t, p.Tags.All(ctx))), 1)
	g := must(t, vuka.Of(Post.Objects.PrefetchRelated(orm.Prefetch(Post.Tags.String(), Tag.Objects.Filter(Tag.Name.Eq("db")))).Get(ctx, Post.ID.Eq(f.p2.ID))))
	eq(t, "filtered prefetch", len(g.Tags.Rows()), 1)
	loaded := must(t, vuka.Of(Post.Objects.Get(ctx, Post.ID.Eq(f.p1.ID))))
	check(t, loaded.Load(ctx, Post.Tags))
	eq(t, "load", loaded.Tags.Rows()[0].Name, "go")
	// The inverse Rel names: users with a post viewed over 60.
	eq(t, "inverse", count(t, ctx, User.Objects.Filter(orm.Q{"posts__views__gt": 60})), int64(1))
}

func TestWrites(t *testing.T) {
	ctx, f := seed(t)
	n := must(t, vuka.Of(Post.Objects.Filter(Post.Author.Name.Eq("ada")).Update(ctx, orm.Set{"views": orm.SQL("{0} + 1", Post.Views.Expr()), "status": "seen"})))
	eq(t, "updated", n, int64(2))
	check(t, f.p1.Refresh(ctx))
	eq(t, "views", f.p1.Views, 101)
	eq(t, "status", f.p1.Status, "seen")
	f.p1.Title = "Go generics, again"
	f.p1.Likes = 99
	check(t, f.p1.SaveFields(ctx, Post.Title))
	got := must(t, vuka.Of(Post.Objects.Get(ctx, Post.ID.Eq(f.p1.ID))))
	eq(t, "save fields", got.Title+"/"+strconv.Itoa(got.Likes), "Go generics, again/7")
	tag, created, err := Tag.Objects.GetOrCreate(ctx, orm.Q{"name": "go"}, nil)
	check(t, err)
	eq(t, "got", created, false)
	eq(t, "got id", tag.ID, f.golang.ID)
	_, created, err = Tag.Objects.GetOrCreate(ctx, orm.Q{"name": "rust"}, nil)
	check(t, err)
	eq(t, "created", created, true)
	_, created, err = User.Objects.UpdateOrCreate(ctx, orm.Q{"name": "ada"}, orm.Defaults{"email": "ada@new", "age": 37})
	check(t, err)
	eq(t, "updated, not created", created, false)
	eq(t, "update", must(t, vuka.Of(User.Objects.Get(ctx, User.Name.Eq("ada")))).Email, "ada@new")
	_, created, err = User.Objects.UpdateOrCreate(ctx, orm.Q{"name": "cy"}, orm.Defaults{"email": "cy@x"})
	check(t, err)
	eq(t, "update created", created, true)
	check(t, Tag.Objects.BulkCreate(ctx, []*Tag{{Name: "a"}, {Name: "b"}}))
	eq(t, "bulk", count(t, ctx, Tag.Objects.QuerySet), int64(5))
	eq(t, "deleted", must(t, vuka.Of(Post.Objects.Filter(Post.Views.Lt(11)).Delete(ctx))), int64(0)) // bumped to 11
	check(t, f.p3.Delete(ctx))
	eq(t, "row deleted", count(t, ctx, Post.Objects.QuerySet), int64(2))
	if err := Post.Objects.Create(ctx, &Post{Title: "orphan"}); err == nil {
		t.Fatal("a post with no author was created")
	}
	p := must(t, vuka.Of(Post.Objects.Get(ctx, Post.ID.Eq(f.p1.ID))))
	eq(t, "json", p.Meta.V.Lang, "en")
	eq(t, "csv", len(p.Labels.V), 2)
	eq(t, "option", p.Published.IsSome(), true)
	eq(t, "default", must(t, vuka.Of(Post.Objects.Get(ctx, Post.ID.Eq(f.p2.ID)))).Status, "seen")
	eq(t, "raw", len(must(t, vuka.Of(Post.Objects.Raw("SELECT * FROM posts WHERE likes > ?", 5).All(ctx)))), 2)
	eq(t, "exec", must(t, vuka.Of(orm.Exec(ctx, "UPDATE posts SET likes = 0"))), int64(2))
}

type Stats struct {
	Author string `orm:"author__name"`
	Posts  int64
	Total  int
	Liked  int64
}

type Heat struct {
	Title string
	Heat  string
	NTags int64
}

func TestValuesAggregates(t *testing.T) {
	ctx, _ := seed(t)
	rows := must(t, vuka.Of(Post.Objects.Annotate("posts", orm.Count("id")).Annotate("total", orm.Sum("views")).
		Annotate("liked", orm.Count("id").Filter(Post.Likes.Gte(5))).OrderBy(Post.Author.Name.Asc()).
		Values[Stats]("author__name", "posts", "total", "liked").All(ctx)))
	eq(t, "groups", len(rows), 2)
	eq(t, "ada", rows[0], Stats{Author: "ada", Posts: 2, Total: 110, Liked: 2})
	total := must(t, vuka.Of(Post.Objects.Aggregate(ctx, orm.Count("author").Distinct().As("authors"), orm.Avg("likes").As("avg"), orm.Max("views").As("top"))))
	eq(t, "distinct authors", total.Int("authors"), int64(2))
	eq(t, "max", total.Int("top"), int64(100))
	eq(t, "avg", int(total.Float("avg")*3), 28)
	// Aggregates over related rows are read as groups (Values), as the engine has it.
	tagged := must(t, vuka.Of(Post.Objects.Annotate("ntags", orm.Count("tags")).Having(orm.Q{"ntags__gt": 1}).Values[Heat]("title", "ntags").All(ctx)))
	eq(t, "having on related", len(tagged), 1)
	eq(t, "having title", tagged[0].Title, "go tooling")
	order := must(t, vuka.Of(Post.Objects.Annotate("ntags", orm.Count("tags")).OrderBy("-ntags", Post.Title.Asc()).Values[Heat]("title", "ntags").All(ctx)))
	eq(t, "ordered by aggregate", order[0].Title+order[1].Title, "go toolingGo generics")
	groups := must(t, vuka.Of(Post.Objects.Annotate("n", orm.Count("id")).GroupBy(Post.Author.String()).Having(orm.Q{"n__gt": 1}).Values[int64]("n").All(ctx)))
	eq(t, "having", len(groups), 1)
	eq(t, "having n", groups[0], int64(2))
}

func TestExpressions(t *testing.T) {
	ctx, f := seed(t)
	ps := Post.Objects.QuerySet
	title, views, likes := Post.Title.Expr(), Post.Views.Expr(), Post.Likes.Expr()
	eqTitles(t, all(t, ctx, ps.Filter(orm.Lower(title).Eq("go tooling"))), "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Upper(Post.Author.Name.Expr()).Eq("BOB"))), "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Length(title).Lt(10))), "SQL joins")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Year(Post.Published.Expr()).Eq(2025))), "Go generics")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Q{"likes__gt": orm.SQL("{0} / 2", views)})), "SQL joins")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Where(orm.SQL("{0} - {1}", views, likes), "gte", 49)).OrderBy(Post.ID.Asc())), "Go generics", "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Abs(orm.SQL("{0} - 10", likes)).Le(3))), "Go generics")
	eqTitles(t, all(t, ctx, ps.Filter(Post.Body.IContains("GO")).OrderBy(Post.ID.Asc())), "Go generics", "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Where(orm.Coalesce(Post.Editor.ID.Expr(), f.bob.ID), "exact", f.ada.ID))), "go tooling")
	heat := orm.Case(orm.When(Post.Views.Gte(100), "hot"), orm.When(Post.Views.Gte(50), "warm")).Else("cold")
	hs := must(t, vuka.Of(ps.Annotate("heat", heat).OrderBy(Post.ID.Asc()).Values[Heat]("title", "heat").All(ctx)))
	eq(t, "case", hs[0].Heat+hs[1].Heat+hs[2].Heat, "hotcoldwarm")
	score := orm.Switch(Post.Author.Name.Expr()).Case("ada", 1).Case("bob", 2).Else(0)
	eqTitles(t, all(t, ctx, ps.Filter(orm.Where(score, "exact", 2))), "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Where(orm.Cast(views, orm.AsText), "exact", "50"))), "go tooling")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Where(orm.Value("x"), "exact", "x"), Post.Views.Eq(10))), "SQL joins")
	eqTitles(t, all(t, ctx, ps.Filter(orm.Where(orm.SQL("{0} * 2", likes), "exact", 40))), "SQL joins")
	// Conditions take fields as values (F).
	eqTitles(t, all(t, ctx, ps.Filter(orm.Q{"likes__lt": views}).OrderBy(Post.ID.Asc())), "Go generics", "go tooling")
}

func TestSubqueries(t *testing.T) {
	ctx, _ := seed(t)
	latest := Post.Objects.Filter(orm.Q{"author": orm.OuterRef("id")}).OrderBy(Post.Views.Desc()).Limit(1).Values[string]("title")
	type Latest struct {
		Name string
		Top  string
	}
	rows := must(t, vuka.Of(User.Objects.Annotate("top", orm.Subquery(latest)).OrderBy(User.Name.Asc()).Values[Latest]("name", "top").All(ctx)))
	eq(t, "subquery", rows[0].Top+"|"+rows[1].Top, "Go generics|go tooling")
	liked := Post.Objects.Filter(orm.Q{"author": orm.OuterRef("id")}, Post.Likes.Gte(20))
	eq(t, "exists", count(t, ctx, User.Objects.Filter(orm.Exists(liked))), int64(1))
	eq(t, "in", count(t, ctx, User.Objects.Filter(User.ID.InQuery(Post.Objects.Filter(Post.Views.Gte(50)).Values[int64]("author")))), int64(2))
}

func TestPaginate(t *testing.T) {
	ctx, _ := seed(t)
	page := must(t, vuka.Of(orm.Paginate(ctx, Post.Objects.QuerySet, orm.PageRequest{Page: 1, Size: 2, Sort: "likes"}, orm.Sortable(Post.Likes.Name(), Post.Views.Name()))))
	eqTitles(t, page.Items, "go tooling", "Go generics")
	eq(t, "total", page.Total, int64(3))
	page = must(t, vuka.Of(orm.Paginate(ctx, Post.Objects.QuerySet, orm.PageRequest{Page: 1, Size: 5, Search: "joins"}, orm.Searchable(Post.Title.Name()), orm.DefaultSort(Post.Views.Desc()))))
	eqTitles(t, page.Items, "SQL joins")
	n := 0
	for p, err := range Post.Objects.Filter(Post.Views.Gte(50)).Iter(ctx) {
		check(t, err)
		n += p.Views
	}
	eq(t, "iter", n, 150)
}

var committed int

// publishAll publishes the drafts, in a transaction.
@orm.Transaction
func publishAll(ctx context.Context, fail bool) error {
	n := Post.Objects.Filter(Post.Published.IsNull(true)).Update(ctx, orm.Set{"status": "published"})?
	orm.OnCommit(ctx, func(context.Context) { committed += int(n) })?
	if fail {
		return errors.New("stop")
	}
	return nil
}

// renameAll renames every post, and rolls back.
@orm.Transaction
func renameAll(ctx context.Context, title string) Result[int64] {
	n := Post.Objects.Unfiltered().Update(ctx, orm.Set{"title": title})?
	return Err[int64](errors.New("rolled back after " + strconv.FormatInt(n, 10)))
}

func TestTransaction(t *testing.T) {
	ctx, _ := seed(t)
	if err := publishAll(ctx, true); err == nil {
		t.Fatal("no error")
	}
	eq(t, "rolled back", count(t, ctx, Post.Objects.Filter(Post.Status.Eq("published"))), int64(0))
	eq(t, "no commit hook", committed, 0)
	check(t, publishAll(ctx, false))
	eq(t, "committed", count(t, ctx, Post.Objects.Filter(Post.Status.Eq("published"))), int64(2))
	eq(t, "commit hook", committed, 2)
	if r := renameAll(ctx, "x"); r.IsOk() {
		t.Fatal("ok")
	}
	eq(t, "result rolled back", count(t, ctx, Post.Objects.Filter(Post.Title.Eq("x"))), int64(0))
}

func TestEntityAndChanges(t *testing.T) {
	ctx, _ := seed(t)
	check(t, orm.Check())
	e := Entry{Note: "hi"}
	check(t, e.Save(ctx))
	eq(t, "meta table", orm.Objects[Entry]().TableName(), "audit_entries")
	var seen []string
	stop := Tag.Objects.OnChange(func(_ context.Context, c orm.Change[Tag]) { seen = append(seen, c.Row.Name) })
	defer stop()
	check(t, Tag.Objects.Create(ctx, &Tag{Name: "new"}))
	eq(t, "on change", len(seen), 1)
	counted, queries := ormtest.CountQueries(ctx)
	must(t, vuka.Of(Post.Objects.SelectRelated(Post.Author.String()).All(counted)))
	eq(t, "one query", queries(), int64(1))
}
