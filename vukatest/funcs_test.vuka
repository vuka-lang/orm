package vukatest

import (
	"strings"
	"testing"

	"github.com/vuka-lang/orm"
	"github.com/vuka-lang/orm/ormtest"
	"github.com/vuka-lang/orm/sqlite"
	"github.com/vuka-lang/vuka"
)

// A Go function SQLite calls, and the typed function over it.
var vowels = orm.OrderedFunc[int]("vowels", orm.Arity(1))

func init() {
	if err := sqlite.Func("vowels", func(s string) int { return strings.Count(strings.ToLower(s), "o") }); err != nil {
		panic(err)
	}
}

func TestCustomFunctions(t *testing.T) {
	if ormtest.Driver() != "sqlite" {
		t.Skip("vowels is a Go function of SQLite's")
	}
	ctx, _ := seed(t)
	// The fields' expressions are the function's arguments.
	title, body := Post.Title.Expr(), Post.Body.Expr()
	eq(t, "filter", must(t, vuka.Of(Post.Objects.Filter(vowels(title).Ge(2)).Count(ctx))), int64(1))
	eqTitles(t, must(t, vuka.Of(Post.Objects.Order(vowels(body).Desc(), orm.Asc(Post.ID.Expr())).Limit(1).All(ctx))), "go tooling")
	eqTitles(t, must(t, vuka.Of(Post.Objects.Filter(vowels(title).Eq(1), Post.Views.Gt(50)).All(ctx))), "Go generics")
	type V struct {
		Title string
		N     int
	}
	vs := must(t, vuka.Of(Post.Objects.Annotate("n", vowels(title)).OrderBy(Post.ID.Asc()).Values[V]("title", "n").All(ctx)))
	eq(t, "values", vs[0].N+vs[1].N+vs[2].N, 5)
	eq(t, "annotate", must(t, vuka.Of(Post.Objects.Annotate("v", vowels(title)).Filter(orm.Q{"v__gt": 1}).Count(ctx))), int64(1))
}
