// Package multidb is the Vuka layer's several-database tests: models
// routed by Meta, a CrossDB relation, transactions picking their database
// and a connection handle.
package multidb

import (
	"context"

	"github.com/vuka-lang/orm"
)

type Customer struct {
	orm.Base @orm.Meta{DB: "crm"}
	ID   int64
	Name string @orm.Char{Max: 100}
}

type Order struct {
	orm.Base
	ID       int64
	Total    int
	Customer orm.FK[Customer] @orm.Rel{CrossDB: true, Related: "orders"}
}

type Event struct {
	orm.Base @orm.Meta{Read: "replica", Write: "main"}
	ID   int64
	Kind string @orm.Char{Max: 50}
}

@orm.Database("crm")
type CRM struct{ orm.Conn }

// placeOrder writes an order: its transaction is main's, the order's
// database.
@orm.Transaction
func placeOrder(ctx context.Context, total int, customer int64) error {
	o := Order{Total: total, Customer: orm.FKID[Customer](customer)}
	return o.Save(ctx)
}

// misplaced runs on crm, then writes an order (main's): refused.
@orm.Transaction
@orm.TxOn("crm")
func misplaced(ctx context.Context) error {
	o := Order{Total: 1}
	return o.Save(ctx)
}

type deadlock struct{}

func (deadlock) Error() string    { return "deadlock detected" }
func (deadlock) SQLState() string { return "40P01" }

// flaky fails like a deadlock until its third run.
@orm.Transaction
@orm.Retry(3)
func flaky(ctx context.Context, runs *int) error {
	*runs++
	if *runs < 3 {
		return deadlock{}
	}
	e := Event{Kind: "landed"}
	return e.Save(ctx)
}
