// Package vukatest is the Vuka layer's tests: models written in Vuka,
// queried through field references.
package vukatest

import (
	"time"

	"github.com/vuka-lang/orm"
)

type User struct {
	orm.Base
	ID    int64
	Name  string @orm.Char{Max: 100, Unique: true}
	Email string @orm.Char{Max: 200}
	Age   int
}

type Tag struct {
	orm.Base
	ID   int64
	Name string @orm.Slug{Unique: true}
}

type Post struct {
	orm.Base `json:"-"` @orm.Meta{Table: "posts", Ordering: []string{"-views", "id"}}
	ID        int64              @orm.PK
	Title     string             `json:"title"` @orm.Char{Max: 200}
	Body      string             @orm.LongText
	Author    orm.FK[User]       @orm.Rel{OnDelete: orm.Cascade, Related: "posts"}
	Editor    orm.FK[User]       @orm.Rel{OnDelete: orm.SetNull, Related: "edited", Null: true}
	Tags      orm.M2M[Tag]
	Published Option[time.Time]  @orm.Index
	Views     int                @orm.DefaultTo(0)
	Likes     int
	Status    string             @orm.Char{Max: 20} @orm.DefaultTo("draft")
	Meta      orm.JSON[PostMeta]
	Labels    orm.CSV[string]
	Embedding orm.Vector
}

type PostMeta struct {
	Lang string
}

@orm.Meta{Table: "audit_entries"}
@orm.Entity
type Entry struct {
	orm.Base
	ID   int64
	Note string
}

// Indexes: MySQL matches a document by a FULLTEXT index of its columns.
func (Post) Indexes() []orm.Index { return []orm.Index{orm.FullTextIndex("title", "body")} }

// Live is the published posts, a static method of Post.
func Post.Live() orm.Query[Post] { return Post.Objects.Filter(Post.Published.NotNil()) }

func managers() []orm.AnyManager {
	return []orm.AnyManager{orm.Objects[User](), orm.Objects[Tag](), orm.Objects[Post](), orm.Objects[Entry](), orm.Objects[Article]()}
}

// Article is searched: a trigram-indexed title, a generated document
// with its full-text index, an embedding with an HNSW index.
type Article struct {
	orm.Base
	ID        int64
	Title     string       @orm.Char{Max: 200} @orm.Trigram
	Body      string       @orm.LongText
	Search    orm.TSVector @orm.SearchOf{Fields: []string{"title:A", "body:B"}, Config: "english"} @orm.FullText{Config: "english"}
	Embedding orm.Vector   @orm.Dims(3) @orm.HNSW{Metric: orm.Cosine, M: 16}
}

func (Article) Indexes() []orm.Index { return []orm.Index{orm.FullTextIndex("title", "body")} }
