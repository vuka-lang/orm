package vukatest

import (
	"context"
	"testing"

	"github.com/vuka-lang/orm/v2"
	"github.com/vuka-lang/orm/v2/ormtest"
	"github.com/vuka-lang/vuka/v2"
)

// The engine's context and database features need no Vuka form: they take
// no field names. Each is used here as Vuka code uses it.
func TestDatabasesAndObservers(t *testing.T) {
	ctx, _ := seed(t)
	// A mirror: writes reach a second database.
	mirrored, onMirror := ormtest.Mirror(t, ctx, managers()...)
	check(t, Tag.Objects.Create(mirrored, &Tag{Name: "mirrored"}))
	eq(t, "mirror", must(t, vuka.Of(Tag.Objects.Filter(Tag.Name.Eq("mirrored")).Count(onMirror))), int64(1))
	// Observers and repeated statements.
	var sqls int
	stop := orm.Observe(func(_ context.Context, q orm.QueryInfo) { sqls++ })
	must(t, vuka.Of(Post.Objects.Count(ctx)))
	stop()
	eq(t, "observed", sqls, 1)
	warned := 0
	watched := orm.WatchRepeats(ctx, 2, func(context.Context, string, int) { warned++ })
	for _, p := range must(t, vuka.Of(Post.Objects.OrderBy(Post.ID.Asc()).All(watched))) {
		must(t, p.Author.Get(watched)) // an N+1: SelectRelated("author") reads it in one
	}
	eq(t, "n+1 warned", warned, 1)
	// Raw rows into any struct, a schema of the default database.
	type Row struct {
		Title string
		Views int
	}
	rows := must(t, vuka.Of(orm.Raw[Row](ctx, "SELECT title, views FROM posts ORDER BY views DESC")))
	eq(t, "raw[R]", rows[0].Title, "Go generics")
	eq(t, "on schema", must(t, vuka.Of(orm.Objects[Post](orm.DBSchema{}).Count(ctx))), int64(3))
	eq(t, "using", must(t, vuka.Of(Post.Objects.Count(orm.WithDB(context.Background(), dbOf(t, ctx))))), int64(3))
	// Hybrid search: reciprocal-rank fusion of two named orderings.
	fuse := orm.Fuse(Post.Views.Desc(), Post.Likes.Desc())
	fused := must(t, vuka.Of(Post.Objects.Annotate("score", fuse).OrderBy("-score", Post.ID.Asc()).Values[string]("title").All(ctx)))
	eq(t, "fused", fused[0], "Go generics")
}

func dbOf(t *testing.T, ctx context.Context) *orm.DB {
	d, ok := orm.DBFrom(ctx)
	if !ok {
		t.Fatal("no database on the context")
	}
	return d
}
